<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Lucia.Companion.App.Controls">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type c:PlaceOrb}" TargetType="c:PlaceOrb">
      <Setter Property="FontSize" Value="{DynamicResource TextSize16}" />
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="MinHeight" Value="126" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="FocusBorder" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <Grid Name="Orb" Width="72" Height="72">
                  <Ellipse Name="StateRing" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                  <Ellipse Name="SelectionRing" Margin="-6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" StrokeDashArray="2,4" IsVisible="{TemplateBinding IsSelected}" />
                  <Path Width="28" Height="28" Stretch="Uniform" Data="{TemplateBinding Icon}"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Path IsVisible="{TemplateBinding IsPinned}" Width="12" Height="12" Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Data="M4,2 L10,2 9,7 11,9 7,9 7,14 M5,9 L3,9 5,7 Z" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
              </Grid>
              <TextBlock Text="{TemplateBinding PlaceName}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Name="CaptionText" Text="{TemplateBinding Caption}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource TextSize13}" TextAlignment="Center" TextWrapping="Wrap"
                         IsVisible="{Binding Caption, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Name="StatusLine" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource TextSize13}" TextAlignment="Center" TextWrapping="Wrap"
                         IsVisible="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <InlineUIContainer BaselineAlignment="Center">
                  <Viewbox Width="14" Height="14" Margin="0,0,4,0"
                           IsVisible="{Binding StatusIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Path Data="{Binding StatusIcon, RelativeSource={RelativeSource TemplatedParent}}" Width="24" Height="24" Stretch="None" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Viewbox>
                </InlineUIContainer>
                <Run Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Ellipse#StateRing"><Setter Property="Fill" Value="{DynamicResource PanelBrush}" /></Style>
      <Style Selector="^.changed, ^.waiting"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
      <Style Selector="^.working"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" /></Style>
      <Style Selector="^.problem"><Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ProblemBrush}" /></Style>
      <Style Selector="^:selected /template/ Border#FocusBorder"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#FocusBorder"><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" /></Style>
      <Style Selector="^:pressed /template/ Grid#Orb"><Setter Property="Opacity" Value="0.7" /></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
      <Style Selector="^.constellation.quiet /template/ Ellipse#StateRing"><Setter Property="Fill" Value="Transparent" /><Setter Property="Stroke" Value="Transparent" /></Style>
      <Style Selector="^.constellation.unavailable /template/ Ellipse#StateRing"><Setter Property="Fill" Value="Transparent" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeDashArray" Value="2,4" /></Style>
      <Style Selector="^.constellation:selected /template/ Border#FocusBorder"><Setter Property="BorderBrush" Value="Transparent" /></Style>
      <Style Selector="^.constellation:focus-visible /template/ Border#FocusBorder"><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type c:BloomActionButton}" TargetType="c:BloomActionButton">
      <Setter Property="Width" Value="88" /><Setter Property="Height" Value="94" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Spacing="5" HorizontalAlignment="Center">
            <Border Name="ActionCircle" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" BoxShadow="0 4 14 0 #40000000">
              <Path Data="{TemplateBinding Icon}" Width="21" Height="21" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="5,2">
              <TextBlock Text="{TemplateBinding Label}" FontSize="{DynamicResource TextSize13}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="78" />
            </Border>
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#ActionCircle"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#ActionCircle"><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" /><Setter Property="BorderThickness" Value="3" /></Style>
      <Style Selector="^.armed /template/ Border#ActionCircle"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="3" /><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Style>
      <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.7" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="NavigationButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
      <Setter Property="FontSize" Value="{DynamicResource TextSize16}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="NavigationItemFrame" Background="{TemplateBinding Background}" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.rail"><Setter Property="Padding" Value="4,10" /></Style>
      <Style Selector="^.selected"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
      <Style Selector="^.selected.rail"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Style>
      <Style Selector="^:pointerover:not(.selected)"><Setter Property="Background" Value="{DynamicResource ControlBrush}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#NavigationItemFrame"><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" /></Style>
      <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.7" /></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="SegmentButton" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
      <Setter Property="FontSize" Value="{DynamicResource TextSize16}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="SegmentFrame" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked"><Setter Property="Background" Value="{DynamicResource TextBrush}" /><Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" /></Style>
      <Style Selector="^:pointerover:not(:checked)"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#SegmentFrame"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="AttentionRowButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
      <Setter Property="FontSize" Value="{DynamicResource TextSize16}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="RowFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.lead"><Setter Property="Background" Value="{DynamicResource ControlBrush}" /><Setter Property="Padding" Value="12" /></Style>
      <Style Selector="^.lead.problem"><Setter Property="BorderBrush" Value="{DynamicResource ProblemBrush}" /></Style>
      <Style Selector="^.lead.waiting"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
      <Style Selector="^.lead.unavailable"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Style>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource ControlBrush}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#RowFrame"><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
      <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.7" /></Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="TemplatedControl"><Setter Property="FontFamily" Value="{DynamicResource BodyFont}" /><Setter Property="FontSize" Value="{DynamicResource TextSize16}" /></Style>
  <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource BodyFont}" /><Setter Property="FontSize" Value="{DynamicResource TextSize16}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" /><Setter Property="FontSize" Value="{DynamicResource TextSize34}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style Selector="TextBlock.section"><Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" /><Setter Property="FontSize" Value="{DynamicResource TextSize24}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button.theme"><Setter Property="FontFamily" Value="{DynamicResource BodyFont}" /><Setter Property="FontSize" Value="{DynamicResource TextSize16}" /><Setter Property="MinHeight" Value="48" /><Setter Property="Background" Value="{DynamicResource ControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="c|PlaceOrb.constellation /template/ TextBlock"><Setter Property="FontSize" Value="{DynamicResource TextSize14}" /></Style>
  <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource PanelBrush}" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="20" /><Setter Property="BorderBrush" Value="{DynamicResource GraphLineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="TextBox"><Setter Property="FontFamily" Value="{DynamicResource BodyFont}" /><Setter Property="FontSize" Value="{DynamicResource TextSize16}" /><Setter Property="MinHeight" Value="48" /></Style>
  <Style Selector="ComboBox, ListBoxItem, CheckBox, RadioButton, MenuItem"><Setter Property="FontFamily" Value="{DynamicResource BodyFont}" /><Setter Property="FontSize" Value="{DynamicResource TextSize16}" /></Style>
  <Style Selector="TextBlock.zone"><Setter Property="FontSize" Value="{DynamicResource TextSize13}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Margin" Value="4,4,0,0" /></Style>
  <Style Selector="Button.link"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="MinHeight" Value="48" /><Setter Property="Padding" Value="4,8" /></Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ControlBrush}" /></Style>
  <Style Selector="ToggleButton.theme"><Setter Property="FontFamily" Value="{DynamicResource BodyFont}" /><Setter Property="FontSize" Value="{DynamicResource TextSize16}" /><Setter Property="MinHeight" Value="48" /><Setter Property="Background" Value="{DynamicResource ControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="ToggleButton.theme:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ControlBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="ToggleButton.pin"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /><Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="{DynamicResource ControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="ToggleButton.pin:checked"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="ToggleButton.pin:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.theme.armed"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="Border.segments"><Setter Property="Background" Value="{DynamicResource ControlBrush}" /><Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="3" /><Setter Property="BorderBrush" Value="{DynamicResource GraphLineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.round"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /><Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="{DynamicResource ControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="Button.round:disabled"><Setter Property="Opacity" Value="0.35" /></Style>
  <Style Selector="Button.theme.selected"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.row"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="14,10" /></Style>
  <Style Selector="Button.nav Path"><Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Stretch" Value="None" /><Setter Property="StrokeThickness" Value="1.7" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /></Style>
  <Style Selector="Button.nav TextBlock"><Setter Property="FontSize" Value="{DynamicResource TextSize13}" /><Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button.nav.selected TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="RadioButton.segment TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="RadioButton.segment:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="RadioButton.segment:checked TextBlock"><Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
</Styles>
