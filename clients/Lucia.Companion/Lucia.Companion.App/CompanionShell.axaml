<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lucia.Companion.App.CompanionShell" Background="{DynamicResource CanvasBrush}">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="16,8,16,0">
      <TextBlock Text="Lucia" FontFamily="{DynamicResource DisplayFont}" FontSize="{DynamicResource TextSize24}" VerticalAlignment="Center" />
    <WrapPanel HorizontalAlignment="Right">
      <Button Name="AppearanceButton" Content="Options" Classes="theme" Margin="0,0,8,0" />
      <Button Name="BuildHomeButton" Content="Setup" AutomationProperties.Name="Build your home" Classes="theme" Margin="0,0,8,0" />
      <Button Name="StoryButton" Content="Story" Classes="theme" />
      <Button Name="RefreshHomeReports" Classes="theme" IsVisible="False"><TextBlock Text="Refresh reports" TextWrapping="Wrap" /></Button>
    </WrapPanel>
    </DockPanel>
    <StackPanel Name="StorageFooter" DockPanel.Dock="Bottom" Margin="16,8,16,12" Spacing="8">
      <TextBlock Name="StorageStatus" Classes="muted" FontSize="{DynamicResource TextSize13}" />
      <Button Name="RetrySaveButton" Content="Retry save" Classes="theme" IsVisible="False" HorizontalAlignment="Left" />
      <Button Name="ReviewSaveConflict" Classes="theme" IsVisible="False" HorizontalAlignment="Left" AutomationProperties.Name="Review save conflict, both versions are preserved">
        <TextBlock Text="Review save conflict" TextWrapping="Wrap" />
      </Button>
    </StackPanel>
    <ContentControl Name="ScreenHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </DockPanel>
</UserControl>
