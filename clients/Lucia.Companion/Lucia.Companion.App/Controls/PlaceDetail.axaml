<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lucia.Companion.App.Controls.PlaceDetail">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
      <Border Name="PlaceAnchor" Width="56" Height="56" CornerRadius="28" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource GraphLineBrush}" BorderThickness="1">
        <Path Name="PlaceIcon" Width="26" Height="26" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Name="PlaceName" Grid.Column="1" Classes="section" TextWrapping="Wrap" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Name="Reason" Classes="muted" />
    <Button Name="ActionsButton" Classes="theme" Content="Place actions" HorizontalAlignment="Left" />
    <TextBlock Name="Connections" Classes="muted" FontSize="13" />
    <StackPanel Name="Observations" />
    <TextBlock Name="EmptyText" Text="No observation bindings configured for this place." Classes="muted" />
  </StackPanel>
</UserControl>
