<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lucia.Companion.App.Controls.ObservationRow">
  <Grid>
  <Border Name="ChangeEmphasis" Margin="-4,5" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Opacity="0" IsHitTestVisible="False" />
  <Border Padding="0,14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
    <Path Name="ReadingIcon" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Top" IsVisible="False" />
    <StackPanel Grid.Column="1" Spacing="5">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Name="LabelText" TextWrapping="Wrap" />
        <TextBlock Name="ValueText" Grid.Column="1" FontWeight="SemiBold" MaxWidth="150" TextWrapping="Wrap" />
      </Grid>
      <TextBlock Name="PreviousText" Classes="muted" FontSize="{DynamicResource TextSize13}" />
      <TextBlock Name="TimeText" Classes="muted" FontSize="{DynamicResource TextSize13}" />
    </StackPanel>
    </Grid>
  </Border>
  </Grid>
</UserControl>
