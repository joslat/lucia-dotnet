<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Lucia.Companion.App.Controls"
             x:Class="Lucia.Companion.App.Controls.BloomActions" FontSize="{DynamicResource TextSize16}">
  <!-- Radial: History and Close above the place, Open to its left and Pin to its right, as in the radial artboard. -->
  <Grid Width="288">
  <Grid Name="RadialLayout" Width="288" Height="292">
    <Ellipse Fill="{DynamicResource PanelBrush}" />
  <Canvas Width="288" Height="292">
    <c:BloomActionButton Name="HistoryButton" Canvas.Left="45" Canvas.Top="27" Label="History"
                         Icon="M4.5,12 A7.5,7.5 0 1 0 6.7,6.7 M3.5,4 L3.5,8 7.5,8 M12,8 L12,12 15,14" />
    <c:BloomActionButton Name="CloseButton" Canvas.Left="155" Canvas.Top="27" Label="Close" Icon="M5,5 L19,19 M19,5 L5,19" />
    <Border Canvas.Left="108" Canvas.Top="110" Width="72" Height="72" CornerRadius="36" Background="{DynamicResource PanelBrush}" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" BoxShadow="0 5 22 0 #60000000">
      <Path Name="PlaceIcon" Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Border Canvas.Left="88" Canvas.Top="187" Width="112" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="4,2">
      <TextBlock Name="Heading" FontSize="{DynamicResource TextSize13}" TextAlignment="Center" TextWrapping="Wrap" />
    </Border>
    <c:BloomActionButton Name="OpenButton" Canvas.Left="2" Canvas.Top="139" Label="Open" Icon="M7,17 L17,7 M9,7 L17,7 17,15" />
    <c:BloomActionButton Name="PinButton" Canvas.Left="198" Canvas.Top="139" Label="Pin place" Icon="M6,3 L18,3 16,11 20,15 4,15 8,11 Z M12,15 L12,23" />
  </Canvas>
  </Grid>
  <Border Name="LargeTextActions" IsVisible="False" Classes="panel" Padding="12">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="400">
      <StackPanel Spacing="8">
        <TextBlock Name="LargeHeading" Classes="section" TextWrapping="Wrap" />
        <Button Name="LargeOpen" Content="Open" Classes="theme" HorizontalAlignment="Stretch" />
        <Button Name="LargeHistory" Content="History" Classes="theme" HorizontalAlignment="Stretch" />
        <Button Name="LargePin" Content="Pin place" Classes="theme" HorizontalAlignment="Stretch" />
        <Button Name="LargeClose" Content="Close" Classes="theme" HorizontalAlignment="Stretch" />
      </StackPanel>
    </ScrollViewer>
  </Border>
  </Grid>
</UserControl>
