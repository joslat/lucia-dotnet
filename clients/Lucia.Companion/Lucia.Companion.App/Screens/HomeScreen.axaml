<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Lucia.Companion.App.Controls"
             x:Class="Lucia.Companion.App.Screens.HomeScreen" Background="{DynamicResource CanvasBrush}">
  <!-- THESIS: A stable, legible home graph with truthful observations, attributed request topics, phases and qualified current target areas.
       OWN-WORLD: Constellation circles, physical-connection lines, Observatory light/dark and local Outfit/DM Sans.
       STORY: See places and attention, open readings, pin a place through accessible Bloom actions. Connected Lucia now shows reported topics/phases and current target areas, never origin guesses, physical-result claims or timer-generated progress.
       FIRST VIEWPORT: Home identity, offline notice, Your places first; attention and details alongside on tablet, a separate detail view on phone.
       FORM: Approved Constellation native composition. Seed: approved-constellation-home.
       FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
  <ScrollViewer Name="ContextScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
  <Grid Name="HomeRoot" RowDefinitions="Auto,*" Margin="16">
    <!-- Phone: name and chip, then date, headline and subline stacked. Tablet: date and name, a divider, the headline beside them, the chip at the end. -->
    <Grid Name="HomeContext" Margin="4,0,4,12" ColumnSpacing="10" RowSpacing="10">
      <StackPanel Name="HomeIdentity" Spacing="2" VerticalAlignment="Center">
        <TextBlock Name="HomeName" Classes="section" TextWrapping="Wrap" />
      </StackPanel>
      <Border Name="HeaderDivider" Width="1" Margin="14,4" Background="{DynamicResource GraphLineBrush}" IsVisible="False" />
      <StackPanel Name="HeadlineBlock" Spacing="4">
        <TextBlock Name="HomeDate" Classes="muted" FontSize="{DynamicResource TextSize13}" />
        <TextBlock Name="AttentionHeadline" FontFamily="{DynamicResource DisplayFont}" FontWeight="Medium" TextWrapping="Wrap" />
        <TextBlock Name="AttentionSummary" Classes="muted" FontSize="{DynamicResource TextSize14}" TextWrapping="Wrap" />
      </StackPanel>
      <Border Name="DemoBadge" Background="{DynamicResource ControlBrush}" CornerRadius="16" Padding="12,8" VerticalAlignment="Top" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Name="LiveDot" Width="8" Height="8" Fill="{DynamicResource SageBrush}" VerticalAlignment="Center" IsVisible="False" />
          <TextBlock Name="HomeModeLabel" Text="Offline demo" FontSize="{DynamicResource TextSize13}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <TextBlock Name="SourceNotice" Text="Synthetic readings. No live household data." Classes="muted" FontSize="{DynamicResource TextSize13}" />
    </Grid>
    <ScrollViewer Name="HomeScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="HomeScrollContent" Spacing="12">
      <Grid Name="HomeGrid" ColumnDefinitions="*,340" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
        <StackPanel Name="MainPanel" Spacing="16">
        <Border Name="PlacesCard" Classes="panel" Padding="12">
          <StackPanel Spacing="10">
            <WrapPanel Name="PlacesHeading" ItemSpacing="14" LineSpacing="2">
              <TextBlock Text="Your places" Classes="section" />
              <TextBlock Text="Tap a place for readings. Use Place actions to pin it." Classes="muted" FontSize="{DynamicResource TextSize13}" VerticalAlignment="Center" />
            </WrapPanel>
            <c:HomeConstellation Name="Constellation" />
          </StackPanel>
        </Border>
        <Border Name="TodayCard" Classes="panel" Padding="16">
          <c:TodaySoFar Name="TodaySoFar" />
        </Border>
        <Border Name="LuciaCard" Classes="panel" Padding="12">
          <StackPanel Spacing="8">
            <c:LuciaNow Name="DemoLuciaNow" />
            <c:ConnectedLuciaNow Name="ConnectedLuciaNotice" IsVisible="False" />
          </StackPanel>
        </Border>
        </StackPanel>
        <StackPanel Name="SidePanel" Grid.Column="1" Spacing="16">
        <Border Name="AttentionCard" Classes="panel" Padding="16">
          <c:AttentionList Name="Attention" />
        </Border>
        <Border Name="DesktopDetailCard" Classes="panel" Padding="16">
          <StackPanel Spacing="18">
            <c:PlaceDetail Name="DesktopDetail" />
          </StackPanel>
        </Border>
        </StackPanel>
      </Grid>
      <Expander Name="CustomizeHome" Header="Customize" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <c:HomeSectionOrder Name="SectionOrderEditor" Margin="0,8,0,4" />
      </Expander>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="DetailScroll" Grid.Row="1" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
      <c:PlacePage Name="PlacePage" />
    </ScrollViewer>
    <Border Name="BloomShade" Grid.RowSpan="2" Background="#80000000" IsVisible="False" IsHitTestVisible="False" />
    <Popup Name="ActionPopup" Grid.Row="1" Placement="Center" IsLightDismissEnabled="True" ShouldUseOverlayLayer="True">
      <c:BloomActions Name="PlaceActions" />
    </Popup>
  </Grid>
  </ScrollViewer>
</UserControl>
